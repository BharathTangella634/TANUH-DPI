# ── App Secrets ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env itself.
ABDM_AUTH_ENABLED=false
NHCX_AUTH_ENABLED=false
ABDM_SECRET_KEY=<CHANGE_ME>
NHCX_SECRET_KEY=<CHANGE_ME>
ABDM_TOKEN_EXPIRY_DAYS=1
NHCX_TOKEN_EXPIRY_DAYS=1
FORGENSIC_SECRET_KEY=<CHANGE_ME>
FORGENSIC_AUTH_ENABLED=false
FORGENSIC_TOKEN_EXPIRY_DAYS=1
MYSQL_USER=<CHANGE_ME>
MYSQL_PASSWORD=<CHANGE_ME>

# ── Admin dashboard login (dpi.tanuh.ai/admin-dashboard) ──────────────────────
ADMIN_DASHBOARD_USERNAME_SECRET=admin-dashboard-username
ADMIN_DASHBOARD_PASSWORD_SECRET=admin-dashboard-password
ADMIN_DASHBOARD_SECRET_KEY_SECRET=admin-dashboard-secret-key

# ── Autoscale monitoring ────────────────────────────────────────────────────────
LOKI_HOST=127.0.0.1
GCE_PROJECT=proj-dpi-shared
GCE_REGION=asia-south1
GCE_MIG_NAME=dpi-mig