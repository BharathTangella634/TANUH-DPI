# ── VM Connection ──────────────────────────────────────────────────────────────
VM_HOST=<CHANGE_ME>
VM_USER=<CHANGE_ME>
VM_PASSWORD=<CHANGE_ME>

# ── App Secrets (from VM .env, written by deploy workflow) ────────────────────
ABDM_AUTH_ENABLED=false
NHCX_AUTH_ENABLED=false
ABDM_SECRET_KEY=dev
NHCX_SECRET_KEY=dev
ABDM_TOKEN_EXPIRY_DAYS=1
NHCX_TOKEN_EXPIRY_DAYS=1
FORGENSIC_SECRET_KEY=dev
FORGENSIC_AUTH_ENABLED=false
FORGENSIC_TOKEN_EXPIRY_DAYS=1
MYSQL_USER=dpi_logger
MYSQL_PASSWORD=Tanuh12345!

# ── Admin dashboard login (dpi.tanuh.ai/admin-dashboard) ──────────────────────
# Temporary single shared credential — planned to be replaced with SSO/OIDC
# once the monitoring dashboards are no longer publicly reachable without auth.
ADMIN_DASHBOARD_USERNAME=Admin
ADMIN_DASHBOARD_PASSWORD=Admin@TANUH_12345!
ADMIN_DASHBOARD_SECRET_KEY=dev-change-me-in-production

# ── Autoscale monitoring (see build/AUTOSCALE_MONITORING_PLAN.md) ────────────
# LOKI_HOST: internal IP of the VM running the monitoring stack (Loki).
# Every app VM's Promtail needs this to ship logs to the shared Loki.
LOKI_HOST=127.0.0.1
# GCE_* let target-discovery find the current dpi-mig VMs via the GCE API.
GCE_PROJECT=proj-dpi-shared
GCE_REGION=asia-south1
GCE_MIG_NAME=dpi-mig